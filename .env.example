# Square API Configuration
# Copy this file to .env for local development
# Set these as environment variables in Netlify Dashboard for production

# Your Square Access Token (from Square Developer Dashboard)
# Sandbox: Use sandbox token for testing
# Production: Use production token for live site
SQUARE_ACCESS_TOKEN=EAAAl_gpI1lAZSB2VjJINofVTsYOqceEb65fBEkS0L5BLopi_jgomfn2Jz3Y0Uin

# Your Square Application ID (from Square Developer Dashboard)
SQUARE_APPLICATION_ID=sq0idp-KlxYoni-y591Xqzwtrd6tg

# Your Square Location ID (from Square Dashboard > Locations)
SQUARE_LOCATION_ID=LJ2GYNS1EPVJG

# Environment: "sandbox" for testing, "production" for live
SQUARE_ENVIRONMENT=production

# Site URL (used for checkout redirects)
# Local: http://localhost:8888
# Production: https://honeylightcreations.com
URL=http://localhost:8888
# ══════════════════════════════════════════════════════════════════
# Admin Authentication
# ══════════════════════════════════════════════════════════════════

# Password for accessing the admin interface at /admin.html
# Choose a strong password and keep it secure!
# This password is used to upload new designs and manage the gallery
ADMIN_PASSWORD=your_secure_admin_password_here
